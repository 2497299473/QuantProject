# secrets (never commit)
.env

# 持仓（本地私有：含真实份额/成本，绝不入库）
# 首次使用：复制 holdings.example.json 为 holdings.json 再填真实值
holdings.json

# daily-refreshed, re-fetchable data caches (pull scripts can rebuild)
data/klines/*.json
data/stock_klines/
data/sector_klines/
data/intraday/

# python runtime artifacts
__pycache__/
*.pyc

# virtualenv (rebuild via requirements.txt)
.venv/

# high-churn runtime outputs; longitudinal evidence (jsonl/json) stays tracked
output/*.log
output/*.md
# 例外：预注册文属判据证据（先写死再跑必须可被提交历史自证），不随 output/*.md 一并忽略
!output/forecast_lab_prereg_*.md
output/logs/
output/backups/
# 数据备份目录（本地刷新前的安全副本，可再生，绝不入库）
output/backup_klines_*/
output/backup_stock_klines_*/
output/timesfm/*.tsv
output/sina_nav/

# Forecast Lab 冻结产物（样本版本证据，体积可控、需跨机对比故不入库）
forecast_outputs/

.venv-lab/
